[importlinter]
root_package = rugbrain
include_external_packages = True

[importlinter:contract:routes-thin]
name = Route modules never touch storage/clients directly (thin routers)
type = forbidden
source_modules =
    rugbrain.routes
forbidden_modules =
    qdrant_client
    httpx
    clickhouse_connect
    duckdb
ignore_imports =
    # KNOWN DEBT (2026-08-21): routes reach storage/http via service modules.
    # TODO(phase-4): push client usage down out of route-reachable services.
    rugbrain.routes.rag_tools -> rugbrain.parquet_analytics
    rugbrain.routes.analyze -> rugbrain.market_context
    rugbrain.routes.analyze -> rugbrain.scanner_feedback
    rugbrain.routes.core -> httpx
    rugbrain.routes.rag_tools -> rugbrain.chain_parquet
    rugbrain.routes.ingest -> rugbrain.embeddings
    rugbrain.routes.analyze -> rugbrain.endpoints
    rugbrain.routes.ingest -> rugbrain.endpoints
    rugbrain.routes.ingest -> rugbrain.qdrant_store
    # qdrant_store reaches httpx through its own store internals; the resolver
    # sub-module does the same for the live-dim probe. Same known debt as the
    # other service-module entries above.
    rugbrain.routes.search_retrieval -> rugbrain.qdrant_store
    rugbrain.routes.search_retrieval -> rugbrain.embeddings
    # canary_routing is the sibling 8B lane module of qdrant_store; the store
    # re-exports its resolver surface, so the two are one storage concern.
    rugbrain.routes.search_retrieval -> rugbrain.canary_routing
    rugbrain.routes.content -> rugbrain.content_engine
    rugbrain.routes.search_federated -> rugbrain.multi_embedder
    rugbrain.routes.content -> rugbrain.trending
    rugbrain.routes.intel -> rugbrain.endpoints
    rugbrain.routes.intel -> rugbrain.evaluation
    rugbrain.routes.intel -> rugbrain.fear_index
    rugbrain.routes.intel -> rugbrain.market_context
    rugbrain.routes.monitors -> rugbrain.exchange_flow
    rugbrain.routes.monitors -> rugbrain.liquidation_heatmap
    rugbrain.routes.monitors -> rugbrain.market_health
    rugbrain.routes.monitors -> rugbrain.monitors.content_digest
    rugbrain.routes.monitors -> rugbrain.monitors.defi_lending
    rugbrain.routes.monitors -> rugbrain.monitors.token_distribution
    rugbrain.routes.monitors -> rugbrain.monitors.twitter_tracker
    rugbrain.routes.monitors -> rugbrain.monitors.hyperliquid_monitor
    rugbrain.routes.monitors -> rugbrain.monitors.social_sentiment
    rugbrain.routes.rag_tools -> httpx
    rugbrain.routes.rag_tools -> rugbrain.compat
    rugbrain.routes.rag_tools -> rugbrain.multimodal
    rugbrain.routes.search -> rugbrain.embeddings
    rugbrain.routes.search -> rugbrain.pre_generation_reflection
    rugbrain.routes.search -> rugbrain.reranker
    rugbrain.routes.search -> rugbrain.search_service
    rugbrain.routes.analyze -> rugbrain.sentiment_engine
    rugbrain.routes.rag_tools -> rugbrain.streaming
    rugbrain.routes.search -> rugbrain.endpoints
    rugbrain.routes.search -> rugbrain.qdrant_store
    rugbrain.routes.intel -> rugbrain.journalism
    rugbrain.routes.intel -> rugbrain.qdrant_store
    rugbrain.routes.analyze -> rugbrain.qdrant_store
    # KNOWN DEBT (2026-09-18): pre-existing transitive httpx paths surfaced
    # when lint-imports was first wired into CI. Same thin-router debt class.
    rugbrain.routes.core -> rugbrain.multi_embedder
    # Target corrected 2026-09-28: this rule named crypto_code_retrieval, but
    # search.py:321 and search_chain_data.py:39 actually import chain_parquet
    # (function-local imports). crypto_code_retrieval is imported by nobody
    # from search, so the rule matched nothing and lint-imports reported
    # 'No matches for ignored import' — the boundary looked clean because the
    # rule was inert, not because the dependency was gone. Sibling rules
    # already name chain_parquet for routes.rag_tools, so this is consistent.
    #
    # REMOVED 2026-09-28 (lane F): the storage reach moved to
    # rugbrain.chain_data_service, outside routes/. There is no longer an
    # edge to ignore. The rule is deleted rather than left in place: a stale
    # ignore re-creates exactly the false green this correction just exposed
    # — it can never match again, and lint-imports only reports
    # 'No matches for ignored import', which reads like a clean bill of
    # health. rag_tools still reaches chain_parquet and keeps its own rule.

    # ── completed 2026-09-28 (lane: import-boundaries) ──────────────────────
    # These 13 edges were MISSING from the list, so the contract reported them
    # as violations. Every one is TRANSITIVE: routes -> a service module ->
    # qdrant_client / httpx. A route calling a service that happens to use a
    # client is CORRECT layering; what the contract forbids is a route opening
    # the client itself. Each entry records the intermediate service so the
    # edge can be re-checked rather than trusted.
    #
    # guard_against_stale_ignores (tests/test_import_boundaries.py) fails if any
    # entry here no longer matches an import, so this list cannot rot back into
    # a false green — which is exactly how the rule named
    # `crypto_code_retrieval` while matching nothing for a fortnight.
    rugbrain.routes.search -> rugbrain.chain_data_service
    rugbrain.routes.search_pkg._shared -> rugbrain.endpoints
    rugbrain.routes.search_pkg.code -> rugbrain.public_crypto_code
    rugbrain.routes.search_pkg.multi -> rugbrain.canary_routing
    rugbrain.routes.search_pkg.multi -> rugbrain.embeddings
    rugbrain.routes.search_pkg.multi -> rugbrain.qdrant_store
    rugbrain.routes.search_pkg.multi -> rugbrain.reranker
    rugbrain.routes.search_pkg.scam -> rugbrain.search_service
    rugbrain.routes.search_pkg.threat -> rugbrain.endpoints
    rugbrain.routes.search_pkg.threat -> rugbrain.reranker
    rugbrain.routes.search_postprocess -> rugbrain.pre_generation_reflection
    rugbrain.routes.search -> rugbrain.public_crypto_code
    rugbrain.routes.search_chain_data -> rugbrain.chain_data_service
    rugbrain.routes.search_pkg.threat -> rugbrain.canary_routing
    rugbrain.routes.search -> rugbrain.canary_routing

    # be0da01 routed the SEARCH path through the lane resolver, as the write
    # path already was. `lane_targets` is a resolution concern, not a storage
    # client: the httpx at the end of the chain is qdrant_store's own
    # connection module, which the entries above already acknowledge as debt.
    # Adding the resolver edge here rather than chasing qdrant_store internals
    # — and the httpx type annotations in lane_dims/collections were dropped
    # while fixing this, so a client type no longer forces the import.
    rugbrain.routes.search_retrieval -> rugbrain.search.lane_targets

[importlinter:contract:routes-isolation]
name = Routes package is independent (no cross-route imports)
type = independence
modules =
    rugbrain.routes

[importlinter:contract:legacy-quarantine]
name = Nobody imports _legacy (quarantined code)
type = forbidden
source_modules =
    rugbrain
forbidden_modules =
    rugbrain._legacy

[importlinter:contract:no-backend-imports]
name = RugBrain never imports rmi-backend (app.*) — standalone sever
type = forbidden
source_modules =
    rugbrain
forbidden_modules =
    app

[importlinter:contract:no-bot-imports]
name = RugBrain never imports rugmunchbot
type = forbidden
source_modules =
    rugbrain
forbidden_modules =
    rugmunchbot