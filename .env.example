# rugbrain — Environment Configuration
# Copy to .env and fill in values (or use gopass)

# ── API authentication (FAIL-CLOSED) ────────────────────────────────
# RMI_RAG_API_KEY authenticates requests via the X-API-Key header.
# If it is EMPTY the API refuses ALL requests with 503 — unless
# DEV_MODE=true (development only, auth open). Never set DEV_MODE in
# production. Generate a key with: openssl rand -hex 32
RMI_RAG_API_KEY=
DEV_MODE=false

# Qdrant vector database
QDRANT_URL=http://localhost:6334
QDRANT_API_KEY=

# Embedding model (llama.cpp Qwen3-Embedding-8B, 2560-dim)
QWEN_EMBED_URL=http://172.22.0.1:8004/v1
RAG_EMBED_MODEL=qwen3-embedding-8b
QWEN_EMBED_DIMS=2560
# Model Services Gateway (auto-tier + strain breaker + cloud fallback)
GATEWAY_EMBED_URL=http://172.22.0.1:8010

# RMI Backend (for query endpoints)
RMI_BACKEND_URL=http://localhost:8000

# Logging
LOG_LEVEL=INFO

# Email accounts endpoint (/api/v1/email/accounts)
# Comma-separated "id|email|type" entries; empty/unset returns an empty list.
RMI_EMAIL_ACCOUNTS=
RMI_WEBMAIL_URL=https://webmail.rugmunch.io/

# Cross-encoder reranker — self-hosted Qwen3-Reranker-8B Q4_K_M (llama.cpp:8003)
# HTTP-only; no model weights or torch in the container.
# From inside the Docker network the host is reachable at 172.22.0.1:8003.
RERANKER_URL=http://172.22.0.1:8003
RERANKER_TIMEOUT=30
# RERANKER_ENABLED=false  # set "false" to disable reranking entirely

# DuckDB snapshot query endpoint (/api/v1/rag/query)
# Reads parquet permanence snapshots from B2 (S3-compatible endpoint).
# The key must have "Allow access to the S3 API" enabled for direct
# DuckDB-from-B2 queries; otherwise the endpoint falls back to a B2
# native download + local DuckDB query.
# B2_APPLICATION_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET_NAME=rmi-rag-permanence
# B2_S3_ENDPOINT=s3.us-east-005.backblazeb2.com

# ── Chain-data parquet (chain-indexer B2) — /api/v1/rag/chain/query ──
# Second DuckDB parquet data source: the chain-indexer's hourly on-chain
# snapshots (transfers + DEX swaps) at b2-crypt:chain-data/parquet/.
# The b2-crypt remote is rclone-crypt encrypted, so the RAG downloads the
# requested prefix via rclone (decrypt) and queries locally with DuckDB.
# RCLONE_CONF must point at a config with the b2-crypt remote (or set
# RCLONE_CONFIG_* env vars for the crypt + underlying b2 remotes).
# B2_CHAIN_DATA_REMOTE=b2-crypt
# B2_CHAIN_DATA_BUCKET=chain-data
# B2_CHAIN_DATA_PREFIX=parquet
# RCLONE_CONF=~/.config/rclone/rclone.conf

# ── Crypto fear index (Panic/Fear) — /api/v1/fear-index ──────────────
# Polled every FEAR_INDEX_POLL_SECONDS; persisted to ClickHouse
# `crypto_fear_index` (best-effort, lazy clickhouse_connect) and cached
# in Redis. Every provider fails open — a dead source is omitted and the
# index renormalizes over the remaining components.
FEAR_INDEX_POLL_SECONDS=300
FEAR_GREED_URL=https://api.alternative.me/fng/?limit=1
# SearXNG self-hosted instance for social sentiment (no API key needed).
SEARXNG_URL=http://localhost:8089/search
FEAR_SOCIAL_QUERY=bitcoin ethereum crypto market
# Optional DataBus-style on-chain provider (exchange netflow / whales /
# liquidations). Leave empty to skip the on-chain component.
# ONCHAIN_SIGNALS_URL=http://localhost:8000/api/v1/databus/fetch/fear_index

# ClickHouse (optional — fear index history + alert ledger)
# CLICKHOUSE_HOST=rmi-clickhouse
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_INTERFACE=http
# CLICKHOUSE_USER=rmi
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_DATABASE=rmi
# CLICKHOUSE_FALLBACK_DATABASE=wallet_memory
# CLICKHOUSE_FEAR_TABLE=crypto_fear_index

# ── Real-time exploit alerts (/api/v1/alerts/*) ────────────────────
# Sub-minute detection: SearXNG (X security accounts) + ClickHouse
# on-chain anomalies + optional ETH/Solana RPC large-tx monitors.
# Pipeline: NATS alerts.crypto.critical → ClickHouse critical_alerts →
# Telegram → Qdrant live_threats → community webhooks (HMAC signed).
REALTIME_TWITTER_POLL_SECONDS=30
REALTIME_ONCHAIN_POLL_SECONDS=60
REALTIME_RPC_POLL_SECONDS=30
REALTIME_LARGE_TX_USD=1000000
REALTIME_ONCHAIN_LOOKBACK_MINUTES=10
REALTIME_NEW_ADDRESS_MAX_TXS=5
REALTIME_ORACLE_WHALE_MIN=3
REALTIME_ORACLE_VOLUME_USD=2000000
REALTIME_NATS_SUBJECT=alerts.crypto.critical
# X accounts tracked via SearXNG (comma-separated).
REALTIME_EXPLOIT_ACCOUNTS=CertiKAlert,PeckshieldAlert,BeosinAlert,BlockSecAlert,SpreekAway,zachxbt
# Dedup / retention windows (seconds).
REALTIME_SEEN_TTL=86400
REALTIME_LIVE_TTL=86400
REALTIME_MAX_RECENT=200
# Telegram push for critical exploits. Empty token/chat disables direct
# send and falls back to the existing rag:telegram_queue (rmi-backend bot).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Optional free RPC endpoints for near-real-time large-tx monitoring.
# RugMunch policy: no RPC URLs in code — set on the host only.
# ETH_RPC_URL=
# SOLANA_RPC_URL=
# ETH_PRICE_USD=3000
# SOL_PRICE_USD=150

# ── Full health dashboard (/api/v1/health/full) ────────────────────
# B2 permanence probe (set when B2 S3 access is configured above).
# B2_S3_ENDPOINT=s3.us-east-005.backblazeb2.com
# B2_BUCKET_NAME=rmi-rag-permanence
# Backend health probe for the scanner section.
# BACKEND_HEALTH_URL=http://localhost:8000/health

# Embedding provider — qwen3-embedding-8b (2560d). EMBED_PROVIDER=local (llama.cpp, default)
# uses QWEN_EMBED_URL above. EMBED_PROVIDER=deepinfra switches to DeepInfra hosted
# Qwen/Qwen3-Embedding-8B (massive-scale; ~80x faster, benchmarked 2026-08-29).
# Unset = auto: deepinfra when DEEPINFRA_API_KEY is set, else local llama.cpp.
# Key MUST come from gopass/.env.rag — never commit a real key.
EMBED_PROVIDER=local
DEEPINFRA_EMBED_URL=https://api.deepinfra.com/v1
DEEPINFRA_EMBED_MODEL=Qwen/Qwen3-Embedding-8B
DEEPINFRA_API_KEY=

# ── Telegram Alt-Ingest (second account) ──────────────────────────────
# Required: API ID and Hash from gopass rmi/telegram-scraper/api_id|api_hash
RAG_TG_ALT_INGEST_API_ID=
RAG_TG_ALT_INGEST_API_HASH=
# Session: either StringSession (preferred) or path to .session file
RAG_TG_ALT_INGEST_SESSION_STRING=
RAG_TG_ALT_INGEST_SESSION_FILE=
# Proxy (optional, Webshare)
RAG_TG_ALT_INGEST_PROXY_HOST=
RAG_TG_ALT_INGEST_PROXY_PORT=
RAG_TG_ALT_INGEST_PROXY_USER=
RAG_TG_ALT_INGEST_PROXY_PASS=
RAG_TG_ALT_INGEST_PROXY_TYPE=http
