# rugbrain-ingest — RAG Threat Ingest (One-shot)
# Source: /path/to/rugbrain/systemd/rugbrain-ingest.service
# Deploy: /etc/systemd/system/rugbrain-ingest.service
#
# Runs the rag-ingest container from docker compose (ingest profile).
# Designed to be triggered by rugbrain-ingest.timer (weekly) or manually:
#   systemctl start rugbrain-ingest.service
#
# This is a oneshot service — it runs the ingest pipeline and exits.
# The ingest will:
#   1. Pull latest threat intel from configured sources
#   2. Chunk, embed, and index into Qdrant
#   3. Cache results in Redis/DragonflyDB
#
# Deploy:
#   cp systemd/rugbrain-ingest.service /etc/systemd/system/
#   cp systemd/rugbrain-ingest.timer   /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now rugbrain-ingest.timer
#
# Manual run:
#   systemctl start rugbrain-ingest.service
#
# View logs:
#   journalctl -u rugbrain-ingest.service -f
#   docker logs rugbrain-ingest

[Unit]
Description=RMI RAG Threat Ingest (One-shot Indexing Pipeline)
Documentation=https://git.rugmunch.io/RugMunchMedia/rugbrain
After=docker.service network-online.target rugbrain.service
Wants=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/path/to/rugbrain
ExecStartPre=docker compose -f /path/to/rugbrain/docker-compose.yml --profile ingest pull rag-ingest
ExecStart=docker compose -f /path/to/rugbrain/docker-compose.yml --profile ingest run --rm rag-ingest
ExecStartPost=docker compose -f /path/to/rugbrain/docker-compose.yml --profile ingest rm -f rag-ingest 2>/dev/null || true
TimeoutStartSec=600

# Security hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false
PrivateTmp=true

# Environment (override via /etc/default/rugbrain or systemctl edit)
EnvironmentFile=-/etc/default/rugbrain

[Install]
WantedBy=multi-user.target
