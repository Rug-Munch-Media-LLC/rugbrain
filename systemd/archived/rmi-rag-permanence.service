# rmi-rag-permanence.service — Nightly Qdrant Snapshot → B2
#
# NAMING: "permanence" here means the B2 BACKUP job, not a serving tier.
# The code/RAG corpus is served from the server (hot set); B2 is backup/DR.
# Blockchain data is the one tier that is authoritative on B2.
# See docs/DATA-PLACEMENT.md.
#
# Source: /path/to/rugbrain/systemd/rmi-rag-permanence.service
# Deploy: /etc/systemd/system/rmi-rag-permanence.service
#
# Runs the B2 permanence sync (scripts/b2_permanence.py) every night at
# 03:00 UTC via rmi-rag-permanence.timer. Exports every Qdrant
# collection as a columnar parquet snapshot (zstd level 19, queryable by
# DuckDB directly from B2) and uploads it to the rmi-rag-permanence B2
# bucket under snapshots/YYYY-MM-DD/. Encryption at rest is handled by
# B2 SSE-B2 (AES256) — no client-side encryption. Pass --format ndjson
# for the legacy compressed-only NDJSON format.
#
# RETENTION PRUNE: every run passes --prune to b2_permanence.py (keeps
# 30 daily / 4 weekly / 12 monthly dated snapshots). The prune pass is a
# DRY-RUN unless B2_PRUNE_LIVE=1 is set in the EnvironmentFile — operator
# opt-in for live deletion. Add `B2_PRUNE_LIVE=1` to b2-permanence.env to
# enable live pruning (see scripts/b2-permanence-run.sh).
#
# Requires duckdb + pyarrow on the host python (verified present) and
# /path/to/b2-permanence.env for B2 credentials.
#
# Data lifecycle: Hot (Qdrant, 90 days) → Cold (B2, forever). Pruning of
# documents older than 90 days runs AFTER a successful upload — see
# src/rugbrain/qdrant_store.py::prune_old_documents.
#
# Deploy:
#   cp systemd/rmi-rag-permanence.service /etc/systemd/system/
#   cp systemd/rmi-rag-permanence.timer   /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now rmi-rag-permanence.timer
#
# Manual run:
#   systemctl start rmi-rag-permanence.service
#
# Logs:
#   /var/log/rmi-rag-permanence.log
#
# Secrets: /path/to/b2-permanence.env (B2_APPLICATION_KEY_ID,
# B2_APPLICATION_KEY, B2_BUCKET_NAME — populated from gopass
# [INTERNAL_SECRET_PATH]; never committed to git). B2_ENCRYPTION_KEY is
# DEPRECATED since 2026-08-01 (B2 SSE-B2 encrypts at rest); it is only
# needed to read/migrate legacy .enc objects.

[Unit]
Description=RMI RAG B2 Permanence — Nightly Qdrant Snapshot to B2
Documentation=https://git.rugmunch.io/RugMunchMedia/rugbrain
After=network-online.target rugbrain.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/path/to/rugbrain
EnvironmentFile=/path/to/b2-permanence.env
# Wrapper adds --prune (dry-run by default; --prune-live only when
# B2_PRUNE_LIVE=1 is set in the EnvironmentFile).
ExecStart=/path/to/rugbrain/scripts/b2-permanence-run.sh
StandardOutput=append:/var/log/rmi-rag-permanence.log
StandardError=append:/var/log/rmi-rag-permanence.log
TimeoutStartSec=3600

# Security hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
