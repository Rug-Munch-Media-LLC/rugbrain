# rugbrain — RAG API Server
# Source: /path/to/rugbrain/systemd/rugbrain.service
# Deploy: /etc/systemd/system/rugbrain.service
#
# Manages the rugbrain FastAPI server via docker compose.
# Depends on: Docker, rmi_network (created by infra stack), Qdrant, Redis
#
# Health check: curl http://localhost:8012/ready  → 200 OK
#
# Deploy:
#   cp systemd/rugbrain.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now rugbrain.service
#
# View logs:
#   journalctl -u rugbrain.service -f
#   docker logs rugbrain-api
#
# Manual rebuild:
#   systemctl stop rugbrain.service
#   cd /path/to/rugbrain && docker compose build rag-api
#   systemctl start rugbrain.service

[Unit]
Description=RMI RAG API Server (FastAPI + Qdrant)
Documentation=https://git.rugmunch.io/RugMunchMedia/rugbrain
After=docker.service network-online.target
Wants=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
WorkingDirectory=/path/to/rugbrain
ExecStartPre=docker compose -f /path/to/rugbrain/docker-compose.yml pull rag-api
ExecStart=docker compose -f /path/to/rugbrain/docker-compose.yml up -d rag-api
ExecStop=docker compose -f /path/to/rugbrain/docker-compose.yml stop rag-api --timeout 30
ExecReload=docker compose -f /path/to/rugbrain/docker-compose.yml up -d --force-recreate --no-deps rag-api
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=45

# Security hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false
PrivateTmp=true

# Environment (override via /etc/default/rugbrain or systemctl edit)
EnvironmentFile=-/etc/default/rugbrain

[Install]
WantedBy=multi-user.target
