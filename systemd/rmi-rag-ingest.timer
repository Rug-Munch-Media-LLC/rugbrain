# rugbrain-ingest.timer — Weekly RAG Threat Ingest Schedule
# Source: /path/to/rugbrain/systemd/rugbrain-ingest.timer
# Deploy: /etc/systemd/system/rugbrain-ingest.timer
#
# Runs rugbrain-ingest.service weekly on Monday at 03:00 UTC.
# This refreshes the threat intelligence vectors in Qdrant.
#
# Deploy:
#   cp systemd/rugbrain-ingest.timer /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now rugbrain-ingest.timer
#
# To see next run:
#   systemctl list-timers rugbrain-ingest.timer
#
# To trigger manually (without waiting for timer):
#   systemctl start rugbrain-ingest.service

[Unit]
Description=RMI RAG Threat Ingest — Weekly Timer
Documentation=https://git.rugmunch.io/RugMunchMedia/rugbrain
Requires=rugbrain-ingest.service

[Timer]
OnCalendar=Mon *-*-* 03:00:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
