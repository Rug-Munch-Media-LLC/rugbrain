# rugbrain-permanence.service — Nightly Qdrant Snapshot → B2 (CHUNKED)
#
# 2026-10-23: replaced a single whole-day invocation with one time-bounded
# chunk per firing. The old unit carried the whole 85-collection run under
# TimeoutStartSec=21600 and was SIGTERM'd at [78/85] four nights running
# (2026-10-20..23), leaving objects in B2 and NO manifest for the day.
#
# The timeout is now 90 min — LOWERED, not raised. The run is sized to fit:
# --max-seconds 4800 (80 min) leaves 10 min of margin, so the process exits on
# its own terms instead of being killed mid-upload. The wrapper's --auto-chunk
# picks the first chunk still owing collections for today, so successive timer
# firings complete the day; a finished day exits in seconds.
#
# Progress survives a kill regardless: the manifest is flushed after every
# collection, and `latest.json` only advances when the day is complete.

[Unit]
Description=RugBrain B2 Permanence — Nightly Qdrant Snapshot to B2
Documentation=https://git.rugmunch.io/RugMunchMedia/rugbrain
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/srv/work/repos/rugbrain
EnvironmentFile=/srv/secrets/b2-permanence.env
# Chunk sizing (override in the EnvironmentFile, not here).
Environment=B2_CHUNK_COUNT=4
# SOFT budget: when an in-flight collection stops scrolling and lands what it
# has. 1800 s = 30 min, inside a 40 min timer slot with 10 min to spare.
Environment=B2_CHUNK_SECONDS=1800
# HARD budget: the last moment a NEW unit (collection or retry) may start.
# 2100 s = 35 min, 5 min inside the slot, so a chunk can never overrun its slot
# and take the next timer firing down with it (measured 2026-10-23: 43.3 min in
# a 40 min slot lost the 15:40 firing outright).
Environment=B2_SLOT_SECONDS=2100
# A partial day must not restart at 0/85 at UTC midnight: inherit completed
# collections from the last N dated manifests (recorded as carried_from).
Environment=B2_CARRY_DAYS=0
# LEVER FOR PER-SHARD COST. Measured 2026-10-23 with sharding on:
#   100,000 pts of 4096-dim == 2,470-2,501 MB and 10.9-12.6 min per shard
#                              (threat_intel_v2_8b__sparsemig, news_v2_8b)
#   => 50,000 pts == ~1.25 GB and ~5-6 min, so ONE shard plus its close,
#   sha256 and upload fits inside the 150 s tail reserve plus the soft budget,
#   and a yield at the deadline costs <6 min of overrun.
Environment=B2_SHARD_POINTS=50000
# Payload-only collections (vectors omitted): the 8B twin inherits the rule.
Environment=B2_PAYLOAD_ONLY_COLLECTIONS=codebase_reference_v2
ExecStart=/srv/work/repos/rugbrain/scripts/b2-permanence-run.sh
StandardOutput=append:/var/log/rmi-rag-permanence.log
StandardError=append:/var/log/rmi-rag-permanence.log
# 90 min: one chunk (80 min budget) plus margin. NOT the old 6 h.
TimeoutStartSec=5400

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
