{
	"version": 1,
	"description": "Example RAG collections with a NEUTRAL schema. The payload contract is: content/text + metadata.*. Replace names and metadata keys with your own deployment's taxonomy.",
	"collections": [
		{
			"name": "docs",
			"description": "General documentation and knowledge-base articles",
			"payload_schema": {
				"content": "string (required) — the chunk text",
				"metadata.title": "string",
				"metadata.source": "string — origin URL or doc id",
				"metadata.collection": "string — collection name",
				"metadata.timestamp": "string (ISO-8601)",
				"metadata.tags": "list[string]"
			},
			"embedding": { "dim": 1024, "model": "bge-m3" },
			"sparse": true
		},
		{
			"name": "news",
			"description": "News articles and market intelligence",
			"payload_schema": {
				"content": "string (required)",
				"metadata.title": "string",
				"metadata.source": "string — feed url",
				"metadata.published_at": "string (ISO-8601)"
			},
			"embedding": { "dim": 1024, "model": "bge-m3" },
			"sparse": true
		},
		{
			"name": "research",
			"description": "Research documents and analysis",
			"payload_schema": {
				"content": "string (required)",
				"metadata.title": "string",
				"metadata.author": "string",
				"metadata.source": "string"
			},
			"embedding": { "dim": 1024, "model": "bge-m3" },
			"sparse": true
		}
	]
}
