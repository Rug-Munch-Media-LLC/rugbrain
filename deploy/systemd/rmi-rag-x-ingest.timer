# RugBrain X social-intel ingestion — every 10 minutes
# Install: sudo cp deploy/systemd/rmi-rag-x-ingest.timer /etc/systemd/system/ && sudo systemctl enable --now rmi-rag-x-ingest.timer

[Unit]
Description=RugBrain X social-intel ingestion every 10 minutes

[Timer]
OnBootSec=3min
OnUnitActiveSec=10min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
