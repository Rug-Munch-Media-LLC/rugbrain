# RugBrain nightly RAG eval — 03:30 daily
# Install: sudo cp deploy/systemd/rmi-rag-eval-nightly.timer /etc/systemd/system/ && sudo systemctl enable --now rmi-rag-eval-nightly.timer

[Unit]
Description=RugBrain nightly RAG eval at 03:30 (full golden set)

[Timer]
OnCalendar=*-*-* 03:30:00
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
